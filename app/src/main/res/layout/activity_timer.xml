<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ss_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WALK WITH ME"
                    android:textColor="@color/ss_red"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan your trip"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stay in control of your walk. Campus security can follow you on the map while the timer runs."
                    android:textColor="@color/ss_text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Privacy note -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ss_red_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Your destination note stays on this phone. Your live location is shared with campus security only while the timer is running, and is deleted when you arrive safely."
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Countdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/ss_card"
                app:cardCornerRadius="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ss_border"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="40dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15:00"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.05" />

                    <TextView
                        android:id="@+id/tv_timer_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set your walk duration"
                        android:textColor="@color/ss_text_muted"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plan my trip card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/ss_card"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ss_border"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan my trip"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Destination -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Destination (optional)"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_destination"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. home, res, station…"
                        android:textColorHint="@color/ss_text_muted"
                        android:textColor="@color/ss_text_primary"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="text"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="This note stays on your phone and clears when the trip ends."
                        android:textColor="@color/ss_text_muted"
                        android:textSize="10sp" />

                    <!-- Duration -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Estimated duration"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:weightSum="4">

                        <Button
                            android:id="@+id/btn_15min"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/ss_red"
                            android:text="15 min"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:strokeWidth="0dp"
                            tools:ignore="TouchTargetSizeCheck" />

                        <Button
                            android:id="@+id/btn_30min"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="30 min"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/ss_border"
                            tools:ignore="TouchTargetSizeCheck" />

                        <Button
                            android:id="@+id/btn_60min"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="60 min"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/ss_border"
                            tools:ignore="TouchTargetSizeCheck" />

                        <Button
                            android:id="@+id/btn_90min"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="90 min"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/ss_border"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_120min"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="120 min"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/ss_border" />

                    <Button
                        android:id="@+id/btn_custom"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Custom time…"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/ss_border" />

                    <!-- Expected arrival flag -->
                    <LinearLayout
                        android:id="@+id/row_expected_arrival"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="14dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_expected_arrival"
                            android:text="Expected arrival at —"
                            android:textColor="@color/ss_red"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:visibility="gone"
                        android:background="@color/ss_border" android:layout_marginTop="20dp" android:layout_marginBottom="16dp" />

                    <!-- Planned contacts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Planned contacts" android:textColor="@color/ss_text_primary"
                                android:textSize="13sp" android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_planned_contacts_count"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Loading…" android:textColor="@color/ss_text_muted" android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_change_contacts"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Change contacts"
                            android:textAllCaps="false"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="11sp"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/ss_border"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:visibility="gone"
                        android:background="@color/ss_border" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />

                    <!-- One-time location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Attach a one-time location" android:textColor="@color/ss_text_primary"
                                android:textSize="13sp" android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Off by default. Captured once when enabled, then only when you tap Refresh."
                                android:textColor="@color/ss_text_muted" android:textSize="11sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_one_time_location"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:thumbTint="@color/ss_card" app:trackTint="@color/ss_border" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_location_snapshot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_location_snapshot"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="No location captured yet"
                            android:textColor="@color/ss_text_secondary" android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_refresh_location"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Refresh" android:textSize="11sp" android:textAllCaps="false"
                            android:textColor="@color/ss_red" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:visibility="gone"
                        android:background="@color/ss_border" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />

                    <!-- Lock screen -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Show on the Lock Screen" android:textColor="@color/ss_text_primary"
                                android:textSize="13sp" android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Shows only the session type and time remaining. No contact, destination or location is shown."
                                android:textColor="@color/ss_text_muted" android:textSize="11sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_lock_screen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:thumbTint="@color/ss_card" app:trackTint="@color/ss_border" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Start / Stop button -->
            <Button
                android:id="@+id/btn_timer_action"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:text="Start walking home"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/ss_red"
                app:cornerRadius="20dp"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/ss_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/ss_red"
            app:itemTextColor="@color/ss_text_secondary"
            app:labelVisibilityMode="labeled"
            app:itemIconGravity="top" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
