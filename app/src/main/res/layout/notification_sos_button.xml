<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="#1B1B2F"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/notification_sos_button"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/ss_red"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_sos_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sos_button_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESS"
            android:textColor="#FFCDD2"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notification_sos_button"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lock Screen SOS Button"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notification_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the red SOS button to trigger immediate emergency alert"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</RelativeLayout>
