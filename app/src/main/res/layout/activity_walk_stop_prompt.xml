<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Why did you stop?"
            android:textColor="@color/ss_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="We noticed you stopped moving during your walk. Let us know you're OK."
            android:textColor="@color/ss_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_prompt_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Alerting campus security in 60 s"
            android:textColor="@color/ss_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prompt_danger"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ss_red"
            android:text="⚠  Danger approaching"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prompt_other"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/ss_text_secondary"
            android:text="Other"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/box_prompt_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_prompt_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tell us why you stopped"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:gravity="top" />

            <Button
                android:id="@+id/btn_prompt_send"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Send &amp; stop timer"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
